# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm
/.pnpm-store/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.axiom
.env
.env.*
!.env.example

# citycode local snapshots (per v2 spec - no database, local JSON cache only)
/.citycode-cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Other
other/

# pnpm lockfile SHOULD be committed - do not ignore it

# vitest JSON reporter output
/.vitest/
